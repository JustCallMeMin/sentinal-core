        {
          "name": "Create Transaction - Minimal (Recommended)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains transaction_id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property(\"transaction_id\");",
                  "    pm.expect(jsonData.status).to.eql(\"received\");",
                  "    pm.expect(jsonData).to.have.property(\"received_at\");",
                  "    ",
                  "    // Save transaction_id for future tests",
                  "    pm.environment.set(\"last_transaction_id\", jsonData.transaction_id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
